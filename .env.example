# API prix.nc. L'API publique ne requiert pas de clé actuellement.
PRIXNC_BASE_URL=https://prix.nc/api/v1
PRIXNC_API_KEY=
PRIXNC_AUTH_HEADER=Authorization

# Base SQLite locale
DATABASE_PATH=./data/app.db

# Durée du cache des réponses prix.nc, en secondes (6 heures par défaut)
PRIXNC_CACHE_TTL_SECONDS=21600
